{
  "name": "solution",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "hono": "^4.6.12",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "cloudflare": {
    "bindings": {
      "V2BOARD_BASE_URL": {
        "description": "V2Board API base URL. Must use HTTPS and include `/api/v1/`, for example `https://panel.example.com/api/v1/`."
      },
      "V2BOARD_SUBSCRIBE_PATH": {
        "description": "V2Board subscription path, usually `/api/v1/client/subscribe`."
      }
    }
  }
}
