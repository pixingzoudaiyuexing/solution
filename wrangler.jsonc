{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solution",
  "main": "src/index.ts",
  "compatibility_date": "2024-03-20",
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "placement": {
    "mode": "smart"
  }
}
